        {
          "id": "5a2442c0-fb82-4244-8866-b59178cf9449",
          "name": "get Latest For Stage",
          "request": {
            "name": "get Latest For Stage",
            "description": {
              "content": "Use this method to generate SBOM(s) based on the latest application evaluation report at the specified stage.\n\nPermissions required: View IQ Elements",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "spdx",
                ":applicationId",
                "stages",
                ":stageId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Enter the format for the SBOM(s) to be generated."
                },
