  "item": [
    {
      "id": "4dca0108-4a8a-441e-a133-b94dcacd4285",
      "name": "SPDX",
      "description": {
        "content": "Use this REST API to generate SPDX SBOMs in XML or JSON formats.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "fc24b53f-fb30-43a1-8ae9-246d245b001f",
          "name": "get By Scan Id",
          "request": {
            "name": "get By Scan Id",
            "description": {
              "content": "Use this method to generate SBOM(s) based on a specific application scan.\n\nPermissions required: View IQ Elemets",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "spdx",
                ":applicationId",
                "reports",
                ":scanId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Enter the format for the SBOM(s) to be generated."
                },
                {
                  "disabled": false,
                  "key": "generateCycloneDx",
                  "value": "false",
                  "description": "Set to `true` to generate an equivalent CycloneDx SBOM. Both SBOMs will be combined as a tar.gz archive."
                },
                {
                  "disabled": false,
                  "key": "spdxVersion",
                  "value": "2.3",
                  "description": "Enter the desired SPDX version, possible values are 2.2|2.3"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "applicationId",
                  "description": "(Required) Enter the applicationId for the application you want to generate the SBOM(s)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "scanId",
                  "description": "(Required) Enter the scanId of the application scan."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "d5bbf9d4-82d3-4c01-904a-6323a8214974",
              "name": "The requested SBOM(s).",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
