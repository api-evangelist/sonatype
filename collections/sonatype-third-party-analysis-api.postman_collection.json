              "content": "SBOM evaluation is an asynchronous operation. Use this method to check on the status of the SBOM evaluation.\n\nPermissions required: Evaluate Applications",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "scan",
                "applications",
                ":applicationId",
                "status",
                ":scanRequestId"
