              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"documentTitle\": \"string\",\n    \"footer\": \"string\",\n    \"header\": \"string\",\n    \"id\": \"string\",\n    \"includeAppendix\": false,\n    \"includeInnerSource\": true,\n    \"includeSonatypeSpecialLicenses\": false,\n    \"includeStandardLicenseTexts\": true,\n    \"includeTableOfContents\": false,\n    \"lastUpdatedAt\": \"1965-03-29T09:12:11.906Z\",\n    \"templateName\": \"string\"\n  },\n  {\n    \"documentTitle\": \"string\",\n    \"footer\": \"string\",\n    \"header\": \"string\",\n    \"id\": \"string\",\n    \"includeAppendix\": true,\n    \"includeInnerSource\": true,\n    \"includeSonatypeSpecialLicenses\": false,\n    \"includeStandardLicenseTexts\": true,\n    \"includeTableOfContents\": false,\n    \"lastUpdatedAt\": \"1965-02-14T21:13:09.041Z\",\n    \"templateName\": \"string\"\n  }\n]",
