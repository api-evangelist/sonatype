{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sonatype Lifecycle Public REST Advanced Search Product License API",
    "version": "1.201.0-02"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Product License",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "installLicense",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v2/product/license",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Use this method to install a product license\n\nPermissions required: Edit System Configuration and Users"
        },
        {
          "info": {
            "name": "uninstallLicense",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v2/product/license"
          },
          "docs": "Use this method to uninstall a product license.\n\nPermissions required: Edit System Configuration and Users"
        }
      ]
    }
  ],
  "bundled": true
}