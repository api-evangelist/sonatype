                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"policies\": [\n    {\n      \"id\": \"string\",\n      \"name\": \"string\",\n      \"ownerId\": \"string\",\n      \"ownerType\": \"REPOSITORY_MANAGER\",\n      \"policyType\": \"string\",\n      \"threatLevel\": 9075\n    },\n    {\n      \"id\": \"string\",\n      \"name\": \"string\",\n      \"ownerId\": \"string\",\n      \"ownerType\": \"REPOSITORY\",\n      \"policyType\": \"string\",\n      \"threatLevel\": 358\n    }\n  ]\n}",
