          "id": "10c7b791-5e0f-4faf-b5d9-3f589b4f35cf",
          "name": "invalidate Cache",
          "request": {
            "name": "invalidate Cache",
            "description": {
              "content": "Clear the integration version cache. Use this endpoint after a new integration version is released to ensure IQ Server immediately recognizes the new version instead of waiting for cache expiration (10 minutes).\n\nPermissions required: Edit System Configuration and Users",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "config",
                "integrationVersions",
                "cache"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": null
          },
          "response": [
            {
              "id": "ab1d2dec-015e-426f-8e6d-eeeff738e1f8",
              "name": "Cache cleared successfully. Returns the number of entries that were invalidated.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v2",
                    "config",
                    "integrationVersions",
                    "cache"
