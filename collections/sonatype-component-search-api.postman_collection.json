                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                          "raw": "{{baseUrl}}/api/v2/componentSearch/cveAffectedComponents?cveId=<string>&cveId=<string>&pageNumber=1&pageSize=10&sortBy=CVE_ID&sortOrder=asc",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "api",
                            "v2",
                            "componentSearch",
                            "cveAffectedComponents"
                          ],
                          "query": [
                            {
                              "description": "(Required) CVE identifier(s). Can be specified multiple times for multiple CVEs.",
                              "key": "cveId",
                              "value": "<string>"
                            },
                            {
                              "description": "(Required) CVE identifier(s). Can be specified multiple times for multiple CVEs.",
                              "key": "cveId",
                              "value": "<string>"
                            },
                            {
                              "description": "Page number (1-indexed, minimum: 1, default: 1)",
                              "key": "pageNumber",
                              "value": "1"
                            },
                            {
                              "description": "Number of items per page (1-1000, default: 10)",
                              "key": "pageSize",
                              "value": "10"
                            },
                            {
                              "description": "Sort field: applicationName, applicationId, componentName, evaluationDate, stage, activeWaiver, violating, cveId. When not specified, sorts by applicationName (asc), then componentName (asc), then cveId (asc)",
                              "key": "sortBy",
                              "value": "CVE_ID"
                            },
                            {
                              "description": "Sort order: asc or desc, default: asc",
                              "key": "sortOrder",
                              "value": "asc"
                            }
                          ]
                        },
                        "description": "Retrieve paginated list of applications containing components affected by one or more CVEs. Multiple CVE IDs can be specified using multiple cveId query parameters (e.g., ?cveId=CVE-2025-1&cveId=CVE-2025-2). Default page number is 1, default page size is 10. Results can be sorted by any column. Default sorting (when sortBy is not specified): applicationName (asc), then componentName (asc), then cveId (asc). When sortBy is explicitly specified, only single-field sorting is applied with the specified sortOrder (default: asc).\nPermissions Required: View IQ Elements"
                      },
                      "response": [
                        {
                          "id": "c5036c6e-9955-4bbc-a1b0-4a39ecde597c",
                          "name": "Paginated list of affected applications and components",
