                                "key": "Authorization",
                                "value": "Basic <credentials>"
                              }
                            ],
                            "url": {
                              "raw": "{{baseUrl}}/api/v2/search/component?stageId=<string>&hash=<string>&coordinates=[object Object]&format=<string>&packageUrl=<string>",
                              "host": [
                                "{{baseUrl}}"
                              ],
                              "path": [
                                "api",
                                "v2",
                                "search",
                                "component"
                              ],
                              "query": [
                                {
                                  "description": "(Required) Specify the evaluation report stage.",
                                  "key": "stageId",
                                  "value": "<string>"
                                },
                                {
                                  "description": "Enter the component hash.",
                                  "key": "hash",
                                  "value": "<string>"
                                },
                                {
                                  "description": "Specify the componentIdentifier object containing the format and coordinates.",
                                  "key": "coordinates",
                                  "value": "[object Object]"
                                },
                                {
                                  "description": "Specify the componentIdentifier object containing the format and coordinates.",
                                  "key": "format",
                                  "value": "<string>"
                                },
                                {
                                  "description": "Enter the packageUrl.",
                                  "key": "packageUrl",
                                  "value": "<string>"
                                }
                              ]
                            }
                          },
                          "status": "OK",
                          "code": 200,
                          "_postman_previewlanguage": "json",
                          "header": [
                            {
                              "key": "Content-Type",
                              "value": "application/json"
                            }
                          ],
                          "cookie": [],
                          "responseTime": null,
                          "body": "{\n  \"criteria\": {\n    \"componentIdentifier\": {\n      \"coordinates\": {\n        \"nondfb\": \"<string>\"\n      },\n      \"format\": \"<string>\"\n    },\n    \"hash\": \"<string>\",\n    \"packageUrl\": \"<string>\",\n    \"stageId\": \"<string>\"\n  },\n  \"results\": [\n    {\n      \"applicationId\": \"<string>\",\n      \"applicationName\": \"<string>\",\n      \"componentIdentifier\": {\n        \"coordinates\": {\n          \"incididunt9e5\": \"<string>\",\n          \"Excepteur_\": \"<string>\",\n          \"qui_5b\": \"<string>\"\n        },\n        \"format\": \"<string>\"\n      },\n      \"dependencyData\": {\n        \"directDependency\": \"<boolean>\",\n        \"innerSource\": \"<boolean>\",\n        \"innerSourceData\": [\n          {\n            \"innerSourceComponentPurl\": \"<string>\",\n            \"ownerApplicationId\": \"<string>\",\n            \"ownerApplicationName\": \"<string>\"\n          },\n          {\n            \"innerSourceComponentPurl\": \"<string>\",\n            \"ownerApplicationId\": \"<string>\",\n            \"ownerApplicationName\": \"<string>\"\n          }\n        ],\n        \"parentComponentPurls\": [\n          \"<string>\",\n          \"<string>\"\n        ]\n      },\n      \"hash\": \"<string>\",\n      \"packageUrl\": \"<string>\",\n      \"reportHtmlUrl\": \"<string>\",\n      \"reportUrl\": \"<string>\",\n      \"threatLevel\": \"<integer>\"\n    },\n    {\n      \"applicationId\": \"<string>\",\n      \"applicationName\": \"<string>\",\n      \"componentIdentifier\": {\n        \"coordinates\": {\n          \"magna_a8a\": \"<string>\",\n          \"eiusmod_0fe\": \"<string>\"\n        },\n        \"format\": \"<string>\"\n      },\n      \"dependencyData\": {\n        \"directDependency\": \"<boolean>\",\n        \"innerSource\": \"<boolean>\",\n        \"innerSourceData\": [\n          {\n            \"innerSourceComponentPurl\": \"<string>\",\n            \"ownerApplicationId\": \"<string>\",\n            \"ownerApplicationName\": \"<string>\"\n          },\n          {\n            \"innerSourceComponentPurl\": \"<string>\",\n            \"ownerApplicationId\": \"<string>\",\n            \"ownerApplicationName\": \"<string>\"\n          }\n        ],\n        \"parentComponentPurls\": [\n          \"<string>\",\n          \"<string>\"\n        ]\n      },\n      \"hash\": \"<string>\",\n      \"packageUrl\": \"<string>\",\n      \"reportHtmlUrl\": \"<string>\",\n      \"reportUrl\": \"<string>\",\n      \"threatLevel\": \"<integer>\"\n    }\n  ]\n}",
                          "createdAt": "2026-10-22T03:13:34.000Z",
