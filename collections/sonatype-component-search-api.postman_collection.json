                            "componentSearch",
                            "downloadComponentSearchReport"
                          ],
                          "query": [
                            {
                              "description": "CVE identifier(s). Can be specified multiple times for multiple CVEs. Defaults to CVE-2025-55182 if not specified.",
                              "key": "cveId",
                              "value": "<string>"
                            },
                            {
                              "description": "CVE identifier(s). Can be specified multiple times for multiple CVEs. Defaults to CVE-2025-55182 if not specified.",
                              "key": "cveId",
                              "value": "<string>"
                            }
                          ]
                        },
                        "description": "Export component search results as CSV (streaming). Identifies applications containing components affected by one or more CVEs. Multiple CVE IDs can be specified using multiple cveId query parameters (e.g., ?cveId=CVE-2025-1&cveId=CVE-2025-2). If no CVE ID is specified, defaults to CVE-2025-55182 (React2Shell) for backwards compatibility. Results are streamed to avoid memory issues with large datasets. Keep-alive mechanism prevents ALB timeouts during long-running queries.\nPermissions Required: View IQ Elements"
                      },
                      "response": [
                        {
                          "id": "230c059f-5ac4-4734-8aef-8a5331ba155d",
                          "name": "CSV file containing the component search results",
