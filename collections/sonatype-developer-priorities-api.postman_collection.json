                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "scanId",
                  "description": "(Required) Enter the scanId."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
