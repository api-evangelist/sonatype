      },
      "item": [
        {
          "id": "851687f8-7887-4026-8590-34e89cf9ba16",
          "name": "get Priorities",
          "request": {
            "name": "get Priorities",
            "description": {
              "content": "Use this method to retrieve all priorities by providing the application ID and scan ID.\n\nPermissions required: View IQ Elements",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "developer",
                "priorities",
                ":applicationId",
                ":scanId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "includeRemediation",
                  "value": "false",
                  "description": "Whether to include remediation type and version for the component or not"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Current page number."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "10",
                  "description": "Enter the no. of results that should be visible per page."
