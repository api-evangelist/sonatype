        {
          "id": "44ce6e38-3b2e-4f41-a9b5-24a7fa792401",
          "name": "GitHub App registration redirect callback",
          "request": {
            "name": "GitHub App registration redirect callback",
            "description": {
              "content": "Handles redirect from GitHub after manifest submission. Exchanges temporary code for permanent app credentials. The user's browser is automatically redirected here by GitHub - not intended for direct use. **Permissions Required:** Configure System Configuration and Users",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "githubApp",
                "redirect"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "(Required) Temporary manifest conversion code from GitHub"
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "OAuth state token for CSRF protection"
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
