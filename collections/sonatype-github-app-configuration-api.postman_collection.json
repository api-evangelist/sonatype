                    {
                      "name": "Generate GitHub App manifest",
                      "id": "bac042b1-0e8f-4b5f-8722-71106f799399",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                          "raw": "{{baseUrl}}/api/v2/githubApp/manifest?ownerId=<string>&organizationName=<string>",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "api",
                            "v2",
                            "githubApp",
                            "manifest"
                          ],
                          "query": [
                            {
                              "description": "(Required) Owner (organization/application) ID",
                              "key": "ownerId",
                              "value": "<string>"
                            },
                            {
                              "description": "(Required) GitHub organization name",
                              "key": "organizationName",
                              "value": "<string>"
                            }
                          ]
                        },
                        "description": "Generate a GitHub App manifest for registration. Returns manifest JSON with a state token for CSRF protection. The state token is cryptographically secure, single-use, and expires after 10 minutes. Submit the manifest to GitHub's app creation flow, which will redirect back to IQ Server with the state token for validation.\n\n**Permissions Required:** Configure System Configuration and Users"
                      },
                      "response": [
                        {
                          "id": "13a6d0a1-6590-4963-b2d9-5982af269dc1",
                          "name": "Manifest generated successfully",
