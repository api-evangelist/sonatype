        {
          "id": "2d82f8c0-6a02-43fa-be94-92e6a8b5b5b8",
          "name": "Generate GitHub App manifest",
          "request": {
            "name": "Generate GitHub App manifest",
            "description": {
              "content": "Generate a GitHub App manifest for registration. Returns manifest JSON with a state token for CSRF protection. The state token is cryptographically secure, single-use, and expires after 10 minutes. Submit the manifest to GitHub's app creation flow, which will redirect back to IQ Server with the state token for validation. \n\n**Permissions Required:** Configure System Configuration and Users",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "githubApp",
                "manifest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ownerId",
                  "value": "<string>",
                  "description": "(Required) Owner (organization/application) ID"
                },
                {
                  "disabled": false,
                  "key": "organizationName",
                  "value": "<string>",
                  "description": "(Required) GitHub organization name"
                }
              ],
              "variable": []
            },
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "bdf8260a-2f00-4da6-b212-1e5c6bcb06f8",
              "name": "Manifest generated successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v2",
                    "githubApp",
                    "manifest"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "ownerId",
                      "value": "<string>"
                    },
                    {
                      "key": "organizationName",
                      "value": "<string>"
                    }
                  ],
