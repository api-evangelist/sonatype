              "content": "Use this method to retrieve the OpenAPI documentation for the specified type of IQ Server REST API.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "endpoints",
                ":apiType"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "apiType",
                  "description": "(Required) Select the type of the API.<ul><li> `public` APIs are Generally Available and fully supported by Sonatype.</li><li> `experimental` APIs are not production ready, may change, and are not intended to be used in critical workloads.</li></ul>"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
