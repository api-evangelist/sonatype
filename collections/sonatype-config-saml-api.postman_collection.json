        {
          "id": "2228e959-db42-4a72-929b-b9302242e950",
          "name": "insert Or Update Saml Configuration",
          "request": {
            "name": "insert Or Update Saml Configuration",
            "description": {
              "content": "Use this method to enable SSO using SAML. This request uses the content type multipart/form-data to transmit the configuration to IQ Server.\n\nPermissions required: Edit System Configuration and Users",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "config",
                "saml"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "identityProviderXml",
                  "value": "<string>",
                  "type": "text",
                  "description": "Enter the SAML metadata XML of your IdP. Refer to the IdP documentation to obtain this metadata."
                },
                {
                  "key": "samlConfiguration",
                  "value": "{\"emailAttributeName\":\"<string>\",\"entityId\":\"<string>\",\"firstNameAttributeName\":\"<string>\",\"groupsAttributeName\":\"<string>\",\"identityProviderName\":\"<string>\",\"lastNameAttributeName\":\"<string>\",\"usernameAttributeName\":\"<string>\",\"validateAssertionSignature\":\"<boolean>\",\"validateResponseSignature\":\"<boolean>\"}",
                  "type": "text",
                  "description": ""
                }
              ]
            }
          },
