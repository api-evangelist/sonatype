        {
          "id": "3ab773d5-2ae2-4a30-a195-f4b19e1b6ac9",
          "name": "automatic Role Assignment",
          "request": {
            "name": "automatic Role Assignment",
            "description": {
              "content": "Use this method to automatically grant the supplied role to all contributors of a repository on a given application.\n\nPrerequisites for automatic role assignment are:<ol><li>SCM configuration for the application and authentication token should exist.</li><li>The contributors to the repository should match a user in IQ based on the supplied mappings.</li><li>Either user mapping strategies have been configured for your organization, or they are provided in the request</li></ol>\n\nPermissions required: Edit access control on the application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "sourceControl",
                "automaticRoleAssignment",
                ":publicId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "publicId",
                  "description": "(Required) Enter the public applicationId for automatic role assignment."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "*/*"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mappings\": [\n    {\n      \"from\": \"<string>\",\n      \"to\": \"<string>\"\n    },\n    {\n      \"from\": \"<string>\",\n      \"to\": \"<string>\"\n    }\n  ],\n  \"role\": \"<string>\"\n}"
            }
          },
          "response": [
            {
              "id": "cc14db60-5310-48d2-98da-363b14f9055b",
              "name": "The 'developer' role has automatically been assigned to all contributors of the repository, who matched IQ Server users via the provided matching strategies.\n\nThe response contains all usernames that were successfully granted the role provided on the given application as well as an indication of which matching strategy was the first to match a user.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v2",
                    "sourceControl",
                    "automaticRoleAssignment",
                    ":publicId"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
