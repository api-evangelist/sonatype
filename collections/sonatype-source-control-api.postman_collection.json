              "body": "{\n  \"authenticationType\": \"string\",\n  \"baseBranch\": \"string\",\n  \"closePrAfterDays\": 1081,\n  \"closePrAfterDaysOpenEnabled\": true,\n  \"closePrOnFailedChecksEnabled\": false,\n  \"commitStatusEnabled\": true,\n  \"enablePullRequests\": true,\n  \"enableStatusChecks\": false,\n  \"id\": \"string\",\n  \"innerSourceAutomatedUpdatesEnabled\": true,\n  \"manualPullRequestsEnabled\": false,\n  \"ownerId\": \"string\",\n  \"provider\": \"string\",\n  \"pullRequestCommentingEnabled\": true,\n  \"remediationPullRequestsEnabled\": true,\n  \"repositoryUrl\": \"string\",\n  \"sourceControlEvaluationsEnabled\": false,\n  \"sourceControlScanTarget\": \"string\",\n  \"sshEnabled\": true,\n  \"statusChecksEnabled\": false,\n  \"token\": \"string\",\n  \"username\": \"string\"\n}",
