            "name": "get By Report Id",
            "description": {
              "content": "Use this method to generate a CycloneDX SBOM for an application.<p>Permissions Required: View IQ Elements",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "cycloneDx",
                ":cdxVersion",
                ":applicationId",
                "reports",
                ":reportId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "applicationId",
                  "description": "(Required) Enter the internal applicationId for the application you want to generate the SBOM. You can also retrieve the applicationId using the Application REST API."
