      "name": "CycloneDX",
      "description": {
        "content": "Use the CycloneDX REST API to generate CycloneDX SBOMs in XML or JSON formats, containing coordinates and licenses for components found in a scan report.",
        "type": "text/plain"
      },
      "item": [
