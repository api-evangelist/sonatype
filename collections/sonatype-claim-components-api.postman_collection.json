  "item": [
    {
      "id": "46787e35-bb46-47f0-b38a-bde76f611ef7",
      "name": "Claim Components",
      "description": {
        "content": "Use this REST API to manage components that are developed in-house and are not open-source.\n\nClaiming the component stores the identity information for the component hash and avoids triggering the Component-Unknown policy.\n\nComponents will have a match state as `Exact` and Identification Source as `Manual`,\nfor subsequent scans or evaluations.",
        "type": "text/plain"
      },
