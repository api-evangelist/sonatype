{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sonatype Lifecycle Public REST Advanced Search Config Source Control API",
    "version": "1.201.0-02"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Config Source Control",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getConfiguration_6",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v2/config/sourceControl"
          },
          "docs": "Use this method to retrieve an existing SCM configuration.\n\nPermissions required: Edit System Configuration and Users"
        },
        {
          "info": {
            "name": "setConfiguration_6",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v2/config/sourceControl",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Use this method to set an SCM Configuration with the IQ Server.\n\nPermissions required: Edit System Configuration and Users"
        },
        {
          "info": {
            "name": "deleteConfiguration_6",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v2/config/sourceControl"
          },
          "docs": "Use this method to delete an existing SCM configuration.\n\nPermissions required: Edit System Configuration and Users"
        }
      ]
    }
  ],
  "bundled": true
}