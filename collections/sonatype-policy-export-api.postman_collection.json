                                    {
                                      "id": "4b37e8a7-8ab9-4f51-820c-bfa6ecc5561f",
                                      "key": "ownerType",
                                      "value": "organization",
                                      "description": "(Required) Type of owner (organization, application, or repository)"
                                    },
