        {
          "id": "ae75662e-581b-470b-8941-e007d7eef99e",
          "name": "get Configuration 3",
          "request": {
            "name": "get Configuration 3",
            "description": {
              "content": "Use this method to review the configuration for an SMTP server.\n\nPermissions required: Edit System Configuration and Users",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "config",
                "mail"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "4afdb244-6081-4f37-97b1-cebe5de6884a",
              "name": "The response contains:<ul><li>`hostname` is the hostname or IP address of the SMTP server used for outgoing mail.</li><li>`port` is the port number on which the SMTP server accepts email requests.</li><li>`username` is the username to authenticate users on the SMTP server.</li><li>`password` is always null, never included for security purposes for this method.</Li><li>`passwordIsIncluded` is always FALSE for this method.</li><li>`sslEnabled` is a boolean flag indicating if the connection to the SMTP server should use SSL/TLS right from the start.</li><li>`startIsEnabled` is a boolean flag indicating if the connection to the SMTP server should attempt to upgrade to SSL/TLS using the STARTTLS command.</li><li>`systemEmail` is the email address used for the FROM header in emails sent by the IQ Server.</li></ul>",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "v2",
                    "config",
                    "mail"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"hostname\": \"string\",\n  \"password\": \"string\",\n  \"passwordIsIncluded\": true,\n  \"port\": 8704,\n  \"sslEnabled\": true,\n  \"startTlsEnabled\": true,\n  \"systemEmail\": \"string\",\n  \"username\": \"string\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
